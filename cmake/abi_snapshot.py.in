"""ABI id of the rbln runtime headers this torch-rbln was built against.

GENERATED BY CMAKE from cmake/abi_snapshot.py.in -- do not edit, do not commit.

BUILT_ABI is what rbln/cmake/RblnAbi.cmake computes over the headers in BUILT_INCLUDE_DIR; the
runtime exports the id of its own headers as rbln_abi_id(). See torch_rbln/_internal/abi_check.py.
"""

BUILT_ABI: str | None = "@RBLN_ABI_ID@"
BUILT_INCLUDE_DIR: str | None = "@INCLUDE_DIR@"
